import asyncio
import os
import random
import sqlite3

from aiogram import Bot, Dispatcher
from aiogram.filters import Command, CommandStart
from aiogram.types import (
    Message,
    ReplyKeyboardMarkup,
    KeyboardButton,
)
from dotenv import load_dotenv

load_dotenv()

# Настройки бота
BOT_TOKEN = os.getenv("BOT_TOKEN")
ADMIN_ID = 1040670594

dp = Dispatcher()

# База данных пользователей
DB_NAME = "bot_database.db"


def init_db():
    with sqlite3.connect(DB_NAME) as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                full_name TEXT,
                coins INTEGER DEFAULT 0
            )
        """)


def save_user(user_id: int, username: str | None, full_name: str):
    with sqlite3.connect(DB_NAME) as conn:
        conn.execute("""
            INSERT INTO users (user_id, username, full_name)
            VALUES (?, ?, ?)
            ON CONFLICT(user_id) DO UPDATE SET
                username = excluded.username,
                full_name = excluded.full_name
        """, (user_id, username, full_name))


def get_user(user_id: int):
    with sqlite3.connect(DB_NAME) as conn:
        return conn.execute(
            "SELECT user_id, username, full_name, coins "
            "FROM users WHERE user_id = ?",
            (user_id,)
        ).fetchone()


def add_coins(user_id: int, amount: int):
    with sqlite3.connect(DB_NAME) as conn:
        conn.execute(
            "UPDATE users SET coins = coins + ? WHERE user_id = ?",
            (amount, user_id)
        )


# Главное меню
main_keyboard = ReplyKeyboardMarkup(
    keyboard=[
        [
            KeyboardButton(text="🎁 Подарки"),
            KeyboardButton(text="⭐ Telegram Stars"),
        ],
        [
            KeyboardButton(text="💎 Telegram Premium"),
            KeyboardButton(text="🎮 Мини-игра"),
        ],
        [
            KeyboardButton(text="👤 Мой профиль"),
            KeyboardButton(text="🆘 Поддержка"),
        ],
    ],
    resize_keyboard=True,
)


@dp.message(CommandStart())
async def start(message: Message):
    user = message.from_user
    save_user(user.id, user.username, user.full_name)

    await message.answer(
        f"👋 Привет, {user.first_name}!\n\n"
        "Добро пожаловать в BILL SHOP.\n\n"
        "Выбери нужный раздел в меню.\n"
        "Каталог пока демонстрационный: реальные покупки "
        "и платежи не подключены.",
        reply_markup=main_keyboard,
    )


@dp.message(Command("id"))
async def show_id(message: Message):
    await message.answer(
        f"Твой Telegram ID: {message.from_user.id}"
    )


@dp.message(Command("admin"))
async def admin(message: Message):
    if message.from_user.id != ADMIN_ID:
        await message.answer("⛔ Эта команда доступна только администратору.")
        return

    with sqlite3.connect(DB_NAME) as conn:
        count = conn.execute(
            "SELECT COUNT(*) FROM users"
        ).fetchone()[0]

    await message.answer(
        "🛠 Панель администратора\n\n"
        f"ID администратора: {ADMIN_ID}\n"
        f"Пользователей в базе: {count}"
    )


@dp.message(lambda m: m.text == "🎁 Подарки")
async def gifts(message: Message):
    await message.answer(
        "🎁 Каталог подарков\n\n"
        "Здесь будет список доступных подарков Telegram.\n"
        "Каталог и цены пока не подключены к актуальным данным.\n"
        "Заказы и оплата сейчас недоступны."
    )


@dp.message(lambda m: m.text == "⭐ Telegram Stars")
async def stars(message: Message):
    await message.answer(
        "⭐ Telegram Stars\n\n"
        "Раздел находится в разработке.\n"
        "Реальные цены и оплата пока не подключены."
    )


@dp.message(lambda m: m.text == "💎 Telegram Premium")
async def premium(message: Message):
    await message.answer(
        "💎 Telegram Premium\n\n"
        "Раздел находится в разработке.\n"
        "Реальные покупки пока не подключены."
    )


@dp.message(lambda m: m.text == "🎮 Мини-игра")
async def game(message: Message):
    user_id = message.from_user.id
    reward = random.randint(1, 5)
    add_coins(user_id, reward)

    user = get_user(user_id)
    balance = user[3] if user else reward

    await message.answer(
        "🎮 Ты сыграл в мини-игру!\n\n"
        f"Начислено учебных монет: {reward}\n"
        f"Баланс учебных монет: {balance}\n\n"
        "Монеты не имеют денежной стоимости, "
        "их нельзя купить, вывести или обменять."
    )


@dp.message(lambda m: m.text == "👤 Мой профиль")
async def profile(message: Message):
    user = get_user(message.from_user.id)

    if not user:
        save_user(
            message.from_user.id,
            message.from_user.username,
            message.from_user.full_name,
        )
        user = get_user(message.from_user.id)

    await message.answer(
        "👤 Твой профиль\n\n"
        f"Имя: {user[2]}\n"
        f"ID: {user[0]}\n"
        f"Username: @{user[1] if user[1] else 'не указан'}\n"
        f"Учебные монеты: {user[3]}"
    )


@dp.message(lambda m: m.text == "🆘 Поддержка")
async def support(message: Message):
    await message.answer(
        "🆘 Поддержка\n\n"
        "По вопросам работы бота обратись к администратору."
    )


@dp.message()
async def unknown(message: Message):
    await message.answer(
        "Не понял команду. Выбери раздел в меню ниже.",
        reply_markup=main_keyboard,
    )


async def main():
    if not BOT_TOKEN:
        raise RuntimeError(
            "Не задан BOT_TOKEN. Добавь новый токен "
            "в переменные окружения хостинга."
        )

    init_db()

    bot = Bot(token=BOT_TOKEN)

    print("BILL SHOP запущен.")

    try:
        await dp.start_polling(bot)
    finally:
        await bot.session.close()


if __name__ == "__main__":
    asyncio.run(main())
