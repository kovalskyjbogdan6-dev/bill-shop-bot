import os
import sqlite3
import random
import asyncio

from aiogram import Bot, Dispatcher, F
from aiogram.filters import CommandStart
from aiogram.types import (
    Message,
    CallbackQuery,
    InlineKeyboardMarkup,
    InlineKeyboardButton,
)
from aiogram.utils.deep_linking import create_start_link


# =========================
# НАСТРОЙКИ
# =========================

TOKEN = os.getenv("BOT_TOKEN", "")
ADMIN_ID = int(os.getenv("ADMIN_ID", "0"))

if not TOKEN:
    raise RuntimeError("Не задан BOT_TOKEN в переменных окружения")

bot = Bot(token=TOKEN)
dp = Dispatcher()

DB_NAME = "bill_shop.db"


# =========================
# БАЗА ДАННЫХ
# =========================

def init_db():
    with sqlite3.connect(DB_NAME) as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                first_name TEXT,
                inviter_id INTEGER,
                coins INTEGER DEFAULT 0
            )
        """)

        conn.execute("""
            CREATE TABLE IF NOT EXISTS referrals (
                invited_id INTEGER PRIMARY KEY,
                inviter_id INTEGER NOT NULL
            )
        """)

        conn.commit()


def register_user(user, inviter_id=None):
    with sqlite3.connect(DB_NAME) as conn:
        existing = conn.execute(
            "SELECT user_id FROM users WHERE user_id = ?",
            (user.id,)
        ).fetchone()

        if existing:
            conn.execute(
                "UPDATE users SET username = ?, first_name = ? WHERE user_id = ?",
                (user.username, user.first_name, user.id)
            )
            conn.commit()
            return

        # Нельзя пригласить самого себя.
        if inviter_id == user.id:
            inviter_id = None

        # Принимаем пригласившего только если он уже есть в базе.
        if inviter_id:
            inviter_exists = conn.execute(
                "SELECT user_id FROM users WHERE user_id = ?",
                (inviter_id,)
            ).fetchone()

            if not inviter_exists:
                inviter_id = None

        conn.execute(
            """
            INSERT INTO users
            (user_id, username, first_name, inviter_id, coins)
            VALUES (?, ?, ?, ?, 0)
            """,
            (user.id, user.username, user.first_name, inviter_id)
        )

        if inviter_id:
            conn.execute(
                "INSERT OR IGNORE INTO referrals (invited_id, inviter_id) VALUES (?, ?)",
                (user.id, inviter_id)
            )

        conn.commit()


def get_coins(user_id):
    with sqlite3.connect(DB_NAME) as conn:
        row = conn.execute(
            "SELECT coins FROM users WHERE user_id = ?",
            (user_id,)
        ).fetchone()

    return row[0] if row else 0


def add_coins(user_id, amount):
    with sqlite3.connect(DB_NAME) as conn:
        conn.execute(
            "UPDATE users SET coins = coins + ? WHERE user_id = ?",
            (amount, user_id)
        )
        conn.commit()


def get_referrals(user_id):
    with sqlite3.connect(DB_NAME) as conn:
        row = conn.execute(
            "SELECT COUNT(*) FROM referrals WHERE inviter_id = ?",
            (user_id,)
        ).fetchone()

    return row[0] if row else 0


def get_total_users():
    with sqlite3.connect(DB_NAME) as conn:
        row = conn.execute(
            "SELECT COUNT(*) FROM users"
        ).fetchone()

    return row[0] if row else 0


# =========================
# КЛАВИАТУРЫ
# =========================

def main_keyboard():
    return InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(
                text="🎁 Бесплатные мишки",
                callback_data="free_bears"
            )
        ],
        [
            InlineKeyboardButton(
                text="🧸 Подарки",
                callback_data="gifts"
            ),
            InlineKeyboardButton(
                text="⭐ Telegram Stars",
                callback_data="stars"
            )
        ],
        [
            InlineKeyboardButton(
                text="💎 Telegram Premium",
                callback_data="premium"
            )
        ],
        [
            InlineKeyboardButton(
                text="🎮 Мини-игры",
                callback_data="games"
            ),
            InlineKeyboardButton(
                text="👤 Профиль",
                callback_data="profile"
            )
        ],
        [
            InlineKeyboardButton(
                text="📊 Статистика",
                callback_data="stats"
            )
        ]
    ])


def back_keyboard(destination="home"):
    return InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(
                text="⬅️ Назад",
                callback_data=destination
            )
        ]
    ])


def games_keyboard():
    return InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(
                text="🎯 Испытать удачу",
                callback_data="play_game"
            )
        ],
        [
            InlineKeyboardButton(
                text="⬅️ Назад",
                callback_data="home"
            )
        ]
    ])


# =========================
# ОТОБРАЖЕНИЕ СТРАНИЦ
# =========================

async def show_page(target, page, user_id=None):
    if user_id is None:
        user_id = target.from_user.id

    if page == "home":
        text = (
            "🛍 <b>BILL SHOP</b>\n\n"
            "Добро пожаловать!\n"
            "Выбери нужный раздел ниже."
        )
        keyboard = main_keyboard()

    elif page == "free_bears":
        link = await create_start_link(
            bot,
            f"ref_{user_id}",
            encode=False
        )

        referrals = get_referrals(user_id)

        text = (
            "🎁 <b>Бесплатные мишки</b>\n\n"
            "Приглашай друзей по своей персональной ссылке!\n\n"
            f"👥 Приглашено друзей: <b>{referrals}</b>\n\n"
            "🔗 <b>Твоя ссылка:</b>\n"
            f"<code>{link}</code>\n\n"
            "Когда новый пользователь впервые запустит бота "
            "по этой ссылке, он будет записан как твой приглашённый.\n\n"
            "ℹ️ Получение реальных подарков пока не подключено."
        )

        keyboard = InlineKeyboardMarkup(inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="🔄 Обновить статистику",
                    callback_data="free_bears"
                )
            ],
            [
                InlineKeyboardButton(
                    text="⬅️ Назад",
                    callback_data="home"
                )
            ]
        ])

    elif page == "gifts":
        text = (
            "🧸 <b>Подарки</b>\n\n"
            "Здесь будет каталог Telegram-подарков.\n"
            "Покупка и выдача подарков пока не подключены."
        )
        keyboard = back_keyboard()

    elif page == "stars":
        text = (
            "⭐ <b>Telegram Stars</b>\n\n"
            "Раздел Telegram Stars.\n"
            "Оплата и выдача звёзд пока не подключены."
        )
        keyboard = back_keyboard()

    elif page == "premium":
        text = (
            "💎 <b>Telegram Premium</b>\n\n"
            "Раздел Telegram Premium.\n"
            "Покупка подписки пока не подключена."
        )
        keyboard = back_keyboard()

    elif page == "games":
        text = (
            "🎮 <b>Мини-игры</b>\n\n"
            "Играй и получай учебные монеты.\n"
            "Монеты не имеют денежной стоимости и не выводятся."
        )
        keyboard = games_keyboard()

    elif page == "profile":
        coins = get_coins(user_id)
        referrals = get_referrals(user_id)

        text = (
            "👤 <b>Твой профиль</b>\n\n"
            f"🆔 ID: <code>{user_id}</code>\n"
            f"🪙 Учебные монеты: <b>{coins}</b>\n"
            f"👥 Приглашено друзей: <b>{referrals}</b>"
        )
        keyboard = back_keyboard()

    elif page == "stats":
        text = (
            "📊 <b>Статистика BILL SHOP</b>\n\n"
            f"👥 Пользователей: <b>{get_total_users()}</b>"
        )
        keyboard = back_keyboard()

    else:
        text = "Неизвестный раздел."
        keyboard = back_keyboard()

    if isinstance(target, Message):
        await target.answer(
            text,
            reply_markup=keyboard,
            parse_mode="HTML"
        )
    else:
        try:
            await target.message.edit_text(
                text,
                reply_markup=keyboard,
                parse_mode="HTML"
            )
        except Exception:
            await target.message.answer(
                text,
                reply_markup=keyboard,
                parse_mode="HTML"
            )


# =========================
# КОМАНДА /START
# =========================

@dp.message(CommandStart())
async def start_handler(message: Message):
    inviter_id = None

    parts = (message.text or "").split(maxsplit=1)

    if len(parts) > 1:
        payload = parts[1].strip()

        if payload.startswith("ref_"):
            try:
                inviter_id = int(payload[4:])
            except ValueError:
                inviter_id = None

    register_user(message.from_user, inviter_id)

    await show_page(
        message,
        "home",
        message.from_user.id
    )


# =========================
# ОБРАБОТКА КНОПОК
# =========================

@dp.callback_query(F.data.in_({
    "home",
    "free_bears",
    "gifts",
    "stars",
    "premium",
    "games",
    "profile",
    "stats"
}))
async def page_handler(callback: CallbackQuery):
    await callback.answer()

    await show_page(
        callback,
        callback.data,
        callback.from_user.id
    )


# =========================
# МИНИ-ИГРА
# =========================

@dp.callback_query(F.data == "play_game")
async def play_game_handler(callback: CallbackQuery):
    await callback.answer()

    user_id = callback.from_user.id

    # Только бесплатные учебные монеты.
    reward = random.randint(1, 5)
    add_coins(user_id, reward)

    coins = get_coins(user_id)

    text = (
        "🎮 <b>Результат игры</b>\n\n"
        f"🪙 Получено учебных монет: <b>+{reward}</b>\n"
        f"💰 Всего монет: <b>{coins}</b>\n\n"
        "Монеты не являются деньгами и не выводятся."
    )

    keyboard = InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(
                text="🎯 Играть ещё",
                callback_data="play_game"
            )
        ],
        [
            InlineKeyboardButton(
                text="⬅️ В меню игр",
                callback_data="games"
            )
        ],
        [
            InlineKeyboardButton(
                text="🏠 Главное меню",
                callback_data="home"
            )
        ]
    ])

    await callback.message.edit_text(
        text,
        reply_markup=keyboard,
        parse_mode="HTML"
    )


# =========================
# АДМИНИСТРАТОР
# =========================

@dp.message(F.text == "/admin")
async def admin_handler(message: Message):
    if not ADMIN_ID or message.from_user.id != ADMIN_ID:
        await message.answer("⛔ У тебя нет доступа к этой команде.")
        return

    await message.answer(
        "🛠 <b>Панель администратора</b>\n\n"
        f"👥 Пользователей: {get_total_users()}\n"
        f"🆔 Твой ID: <code>{message.from_user.id}</code>",
        parse_mode="HTML"
    )


# =========================
# ЗАПУСК
# =========================

async def main():
    init_db()
    print("BILL SHOP запущен")
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
